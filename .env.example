# Server-only secrets. Copy to .env.local; never expose with NEXT_PUBLIC_.
MYSHIPTRACKING_API_KEY=
MYSHIPTRACKING_SECRET_KEY=
AISTREAM_API_KEY=
GFW_API_TOKEN=

# Project services
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_DATABASE_URL=
SUPABASE_POOLER_HOST=aws-1-eu-west-1.pooler.supabase.com
OPENAI_API_KEY=
HERMES_MODEL=gpt-5.6-luna

# Production uses real MyShipTracking reports; the API retains and labels the
# last-known report when a vessel is not currently transmitting.
VESSEL_DATA_MODE=live
APP_URL=https://first-mythos-cup.vercel.app

# Native Hermes Telegram gateway. Comma-separated numeric IDs; Hermes manages
# additions/removals through the protected Fly allowlist workflow.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# Scoped credentials for Hermes to operate without the original computer.
GITHUB_TOKEN=
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
FLY_API_TOKEN=
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=jnqccspdghuyqxpftihk

# A MyShipTracking simple lookup costs 1 credit. Keep this at 60s or above.
VESSEL_CACHE_SECONDS=60
