# Server-only secrets. Copy to .env.local; never expose with NEXT_PUBLIC_.
MYSHIPTRACKING_API_KEY=
MYSHIPTRACKING_SECRET_KEY=
AISTREAM_API_KEY=
GFW_API_TOKEN=

# Project services
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_DATABASE_URL=
SUPABASE_POOLER_HOST=aws-1-eu-west-1.pooler.supabase.com
OPENAI_API_KEY=
HERMES_MODEL=gpt-5.6-luna

# Keep mock in local/production until paid AIS lookups are explicitly approved.
VESSEL_DATA_MODE=mock
APP_URL=https://first-mythos-cup.vercel.app

# Native Hermes Telegram gateway. Seed with the owner's numeric Telegram ID;
# additional users are managed through Hermes' persistent pairing store.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# Scoped credentials for Hermes to operate without the original computer.
GITHUB_TOKEN=
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
FLY_API_TOKEN=
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=jnqccspdghuyqxpftihk

# A MyShipTracking simple lookup costs 1 credit. Keep this at 60s or above.
VESSEL_CACHE_SECONDS=60
